# S3 target for generation and loading (same region as the VeloDB cluster).
# Read by generate.sh (generator destination) and run-load.sh (Doris S3 Load) only; the billing app does not need it.
#
#   cp s3.env.example s3.env && chmod 600 s3.env      # s3.env is git-ignored (S3_ENV_FILE=<path> for another file)
#
# As with .env, variables already set in the environment win. S3_AK / S3_SK default to
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, so with those exported the keys can stay out of this file.
S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
S3_REGION=ap-southeast-1
# S3_AK=<access-key-id>
# S3_SK=<secret-access-key>
S3_BUCKET=<bucket>
S3_PREFIX=telco-cdr
S3_PATH_STYLE=false
# rs3 alias the scripts (re)create from the values above, for listing and wiping
S3_RS3_ALIAS=telco-cdr-s3
