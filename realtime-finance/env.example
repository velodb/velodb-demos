# VeloDB / Doris connection + retention for the realtime-finance demo (finsim).
#
#   cp env.example .env      # then fill in your cluster; .env is git-ignored
#
# finsim reads DIR/.env (ENV_FILE=<path> for another file), but variables already set in your
# environment always win, so you can keep credentials out of files entirely:
#   export VELODB_HOST=... VELODB_USER=... VELODB_PASSWORD=...
#   VELODB_DATABASE=money_market_test ./run.sh -reset      # one-off override
# Never commit real values to this file.

# ---- connection (VeloDB Cloud: the "Connection" page of your warehouse) ----
VELODB_HOST=fe.example.com            # FE / load balancer host name
VELODB_MYSQL_PORT=9030                # MySQL protocol port (queries, DDL)
VELODB_STREAM_LOAD_PORT=8080          # FE HTTP port (stream load of prices / trades / snapshots)
# VELODB_STREAM_LOAD_URL=https://fe.example.com:8443   # optional; default http://VELODB_HOST:VELODB_STREAM_LOAD_PORT
VELODB_USER=admin
VELODB_PASSWORD=change-me

# ---- demo database (created on first run) ----
VELODB_DATABASE=money_market_demo

# ---- history retention (partitions older than this are dropped every 30 min; 0 = keep forever) ----
PRICES_RETENTION_HOURS=48
SNAPSHOTS_RETENTION_DAYS=7
TRADES_RETENTION_DAYS=7               # old trades are folded into carry-forward rows first, so P&L is unchanged
