# VeloDB / Doris connection + table settings for the hyper-search demo.
#
#   cp env.example .env      # then fill in your cluster; .env is git-ignored
#
# Every script loads .env (ENV_FILE=<path> to use another file), but variables already set in
# your environment always win, so you can keep credentials out of files entirely:
#   export VELODB_HOST=... VELODB_USER=... VELODB_PASSWORD=...
#   VELODB_DATABASE=hs_test VELODB_BUCKETS=4 ./create_table_doris.sh     # one-off override
# Never commit real values to this file.

# ---- connection (VeloDB Cloud: the "Connection" page of your warehouse) ----
VELODB_HOST=fe.example.com            # FE / load balancer host name
VELODB_MYSQL_PORT=9030                # MySQL protocol port (queries, DDL, Broker Load)
VELODB_STREAM_LOAD_PORT=8080          # FE HTTP port (stream load, used by the realtime feeder)
# VELODB_STREAM_LOAD_URL=https://fe.example.com:8443   # optional; default http://VELODB_HOST:VELODB_STREAM_LOAD_PORT
VELODB_USER=admin
VELODB_PASSWORD=change-me

# ---- demo table ----
VELODB_DATABASE=demo_hyper_search
VELODB_TABLE=taxi_ping
VELODB_BUCKETS=32                     # hash buckets on geohash6
VELODB_REPLICATION_NUM=1              # 1 on VeloDB Cloud / single-BE clusters, 3 on self-managed HA
VELODB_PARTITION_KEEP_DAYS=497        # static day partitions from day(BASE) - 497 ...
VELODB_PARTITION_AHEAD_DAYS=0         # ... to day(BASE) + 0; created once, never added or dropped automatically
