# VeloDB / Doris connection + loader settings for the observability (log search) demo.
#
#   cp env.example .env      # then fill in your cluster; .env is git-ignored
#
# Every command reads .env (--env <path> / ENV_FILE=<path> to use another file), but variables
# already set in your environment always win, so you can keep credentials out of files entirely:
#   export VELODB_HOST=... VELODB_USER=... VELODB_PASSWORD=...
#   VELODB_TABLE=log_events_test ROWS_PER_SECOND=10000 ./runBackFill.sh     # one-off override
# Never commit real values to this file.

# ---- connection (VeloDB Cloud: the "Connection" page of your warehouse) ----
VELODB_HOST=fe.example.com            # FE / load balancer host name
VELODB_MYSQL_PORT=9030                # MySQL protocol port (DDL, queries from the web UI)
VELODB_STREAM_LOAD_PORT=8080          # FE HTTP port (stream load, used by the loader)
# VELODB_STREAM_LOAD_URL=https://fe.example.com:8443   # optional; default http://VELODB_HOST:VELODB_STREAM_LOAD_PORT
VELODB_USER=admin
VELODB_PASSWORD=change-me

# ---- demo table (DDL in create.sql) ----
VELODB_DATABASE=demo_observability
VELODB_TABLE=log_events

# ---- loader ----
ROWS_PER_SECOND=100                   # 0 = unthrottled
TOTAL_ROWS=1000000000                 # spread evenly over the 2026 event-time year
GENERATOR_THREADS=8

# ---- stream load tuning ----
STREAMLOAD_BATCH_MIB=80
STREAMLOAD_GENERATOR_BATCH_ROWS=10000
STREAMLOAD_LINGER=5000ms
STREAMLOAD_COMPRESSION=gz
STREAMLOAD_UPLOAD_WORKERS=10
STREAMLOAD_UPLOAD_REQUEST_TIMEOUT=60s
STREAMLOAD_UPLOAD_TIMEOUT=60s
STREAMLOAD_MAX_QUEUE_SIZE=10000
STREAMLOAD_MAX_UPLOAD_QUEUE_SIZE=10
STREAMLOAD_MAX_QUEUE_WAIT=0s
STREAMLOAD_LABEL_PREFIX=doris
